{
  "name": "alles-entertainment-editorial",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --mode emulator --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "node ../scripts/contract.mjs && tsc --noEmit && vite build --mode staging",
    "build:prod": "node ../scripts/contract.mjs && tsc --noEmit && vite build --mode prod",
    "preview": "vite preview --host 127.0.0.1",
    "build:local": "node ../scripts/contract.mjs && tsc --noEmit && vite build --mode emulator"
  },
  "dependencies": {
    "firebase": "12.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "typescript": "~5.8.3",
    "vite": "^7.1.12",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}
